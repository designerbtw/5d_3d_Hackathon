{
  "_note": "Белый список параметров, которые агент может менять. Ключи Cura 3.6; добавьте ключи Stereotech из определения Hybrid 530.",
  "layer_height":              {"type": "number",  "min": 0.04, "max": 0.6,  "label": "Высота слоя, мм"},
  "wall_line_count":           {"type": "integer", "min": 1,    "max": 20,   "label": "Число периметров"},
